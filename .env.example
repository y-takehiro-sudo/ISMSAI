# ─────────────────────────────────────────────
# OpenAI API
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────
# Google Chat - Webhook方式
# ─────────────────────────────────────────────
# メンバー向けスペース（全体通知・ユーザー向けタスク・運用チェック）
GOOGLE_CHAT_WEBHOOK_MEMBER=https://chat.googleapis.com/v1/spaces/XXXXXXXX/messages?key=XXXX&token=XXXX
# 管理者向けスペース（管理者向けタスク・年間全体タスク）
GOOGLE_CHAT_WEBHOOK_ADMIN=https://chat.googleapis.com/v1/spaces/XXXXXXXX/messages?key=XXXX&token=XXXX
# 後方互換（旧設定・通常は空欄でよい）
GOOGLE_CHAT_WEBHOOK_URL=

# ─────────────────────────────────────────────
# Google Chat - サービスアカウント方式（任意・IT管理者権限が必要）
# ─────────────────────────────────────────────
GOOGLE_CHAT_CREDENTIALS_JSON=./credentials.json
GOOGLE_CHAT_GROUP_SPACE_ID=
GOOGLE_CHAT_EXEC_SPACE_ID=

# ─────────────────────────────────────────────
# サーバー設定
# 本番デプロイ時は実際のドメインに変更すること
# 例: https://www.example.com または https://isms.example.com
# ─────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
BASE_URL=http://localhost:8000

# ─────────────────────────────────────────────
# セキュリティ（必ず変更すること）
# python -c "import secrets; print(secrets.token_hex(32))" で生成
# ─────────────────────────────────────────────
SECRET_KEY=your-secret-key-change-this-in-production

# 初期管理者アカウント（DB に admin が存在しない場合のみ作成される）
BOOTSTRAP_ADMIN_ID=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# ─────────────────────────────────────────────
# データベース（本番は /app/data/isms.db を推奨）
# ─────────────────────────────────────────────
DB_PATH=/app/data/isms.db

# ─────────────────────────────────────────────
# スケジューラー
# ─────────────────────────────────────────────
DAILY_CHECK_HOUR=8
WEEKLY_CHECK_DAY=monday
